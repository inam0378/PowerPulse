# Postgres connection (Vercel Postgres / Neon). Use the pooled URL here...
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# ...and the direct (non-pooled) URL here, used for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Long random string used to sign login sessions: openssl rand -hex 32
AUTH_SECRET=""
# First admin account, created on first deploy if it does not exist.
ADMIN_EMAIL="you@yourdomain.com"
ADMIN_PASSWORD=""
# Public URL of the site, used for SEO metadata and the sitemap.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# Optional: Vercel Blob token for image/video uploads from the admin dashboard.
BLOB_READ_WRITE_TOKEN=""
